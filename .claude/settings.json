{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/standards/hooks/guard.py\""
          }
        ]
      },
      {
        "matcher": "Agent|Task|Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/standards/hooks/token_guard.py\""
          }
        ]
      }
    ]
  }
}
