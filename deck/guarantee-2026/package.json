{
  "name": "guarantee-2026-infographic",
  "private": true,
  "version": "1.0.0",
  "description": "소상공인 실태조사 인포그래픽 4장 — 이미지 원본을 편집 가능한 PPTX(네이티브 차트 포함)로 재구성",
  "scripts": {
    "build": "node build.js",
    "build:g01": "node build.js --only g01",
    "build:g02": "node build.js --only g02",
    "build:g03": "node build.js --only g03",
    "build:g04": "node build.js --only g04",
    "verify": "node ../namp-2026/tools/py.js verify.py",
    "render": "node ../namp-2026/tools/render.js --dpi 150",
    "assets": "node ../namp-2026/tools/py.js tools/extract-assets.py src",
    "doctor": "node ../namp-2026/tools/doctor.js"
  },
  "comment": "pptxgenjs 는 ../namp-2026/node_modules 를 쓴다. 그쪽에서 npm install 하면 된다."
}
