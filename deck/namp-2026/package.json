{
  "name": "namp-2026-deck",
  "version": "1.0.0",
  "private": true,
  "description": "2026 납품대금 연동제 실태조사 제안서(발췌 11장) 편집 가능 PPTX 생성기",
  "scripts": {
    "build": "node build.js --preset full",
    "build:energy": "node build.js --preset energy",
    "build:matrix": "node build.js --preset matrix",
    "build:roadmap": "node build.js --preset roadmap",
    "build:outcome": "node build.js --preset outcome",
    "build:extra": "node build.js --preset extra",
    "build:search": "node build.js --preset search",
    "build:all": "for k in full energy matrix roadmap outcome extra search; do node build.js --preset $k; done",
    "build:web": "esbuild web/deck.js --bundle --format=iife --global-name=Deck --external:pptxgenjs --outfile=web/bundle.js --log-level=warning",
    "metrics": "node tools/gen-metrics.js",
    "metrics:check": "node tools/check-metrics.js",
    "verify": "python3 verify.py",
    "render": "bash tools/render.sh /tmp/namp-render",
    "serve": "node web/server.js",
    "parity": "node tools/parity.js"
  },
  "dependencies": {
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "font-kopub": "^1.0.2"
  }
}
